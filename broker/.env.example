# Role of this process: should be `broker` for the relay server
ROLE=broker

# Shared secret generated by the broker bootstrap.
# Paste this value into sender and viewer `.env` files so all three match.
SHARED_SECRET=change-me-generate-a-long-random-secret

# TLS listen port (where the broker accepts client connections)
LISTEN_PORT=7000

# Comma-separated list of allowed `SENDER_ID` values (e.g. laptop-01,laptop-02).
# Empty or missing = ALL senders are blocked. There is no wildcard mode.
ALLOWED_SENDERS=laptop-01

# Paths to the broker TLS certificate and private key
TLS_CERT_PATH=../certs/server-cert.pem
TLS_KEY_PATH=../certs/server-key.pem

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Optional: rotating file log (in addition to stdout), via pino-roll. Cross-platform.
# Leave LOG_FILE unset to log only to stdout (e.g. captured by a service manager).
# LOG_FILE=broker.log
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5

# Optional: plain-HTTP, unauthenticated health check on a separate port
# (GET /health -> {status, senders, receiver, uptime}). Leave unset to disable.
# HEALTH_PORT=7001

# Optional: plain-HTTP, unauthenticated Prometheus /metrics endpoint (standard
# scrape pattern — no TLS, no auth). Leave unset to disable.
# METRICS_PORT=9090

# Optional: browser-based web viewer (issue #12, milestone 1 — read-only video,
# JPEG codec only, no input yet). Serves the static app and a WSS endpoint on
# this port (same TLS cert/key as LISTEN_PORT). Leave unset to disable.
# WS_PORT=7443
