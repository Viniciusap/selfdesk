<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- S38: AllowUnsafeBlocks isolated to this project — only the FFmpeg-backed
         H264 codec needs raw pointer access; the rest of the sender does not. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SelfDesk.Sender</RootNamespace>
    <AssemblyName>SelfDesk.Sender.Codec</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\dotnet\SelfDesk.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SelfDesk.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
